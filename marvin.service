[Unit]
Description=Marvin Local LLM Service (llamafile)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/marvin
ExecStart=/bin/sh %h/marvin/scripts/run-model.sh
Restart=on-failure
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
