#!/usr/bin/env python3
import sys
import os
import re
import json
import argparse
import signal
import subprocess
from pathlib import Path
from urllib import request, error

# Configuracoes de conexao
MARVIN_HOST = os.environ.get("MARVIN_HOST", "127.0.0.1")
MARVIN_PORT = os.environ.get("MARVIN_PORT", "8088")
API_URL = f"http://{MARVIN_HOST}:{MARVIN_PORT}/v1/chat/completions"
HEALTH_URL = f"http://{MARVIN_HOST}:{MARVIN_PORT}/health"

# Diretorios padrao
SESSIONS_DIR = Path.home() / ".local" / "share" / "marvin" / "sessions"
REPO_DIR = Path(__file__).resolve().parent
PROMPT_FILE = REPO_DIR / "system_prompt.md"
PROMPT_EXAMPLE = REPO_DIR / "system_prompt.example.md"

DEFAULT_SYSTEM_PROMPT = """Voce e o Marvin, assistente pessoal de desenvolvimento operando no terminal Linux.

Regras de Comportamento Obrigatorias:
- Idioma: Responda sempre em portugues brasileiro, a menos que solicitado expressamente outro idioma.
- Restricao Estrita: DE MANEIRA NENHUMA utilize emojis em suas respostas.
- Duvidas e Ambiguidade: Se um pedido for ambiguo ou faltarem informacoes criticas, faca perguntas para esclarecer antes de assumir premissas.
- Estilo: Seja tecnico, direto e conciso. Va direto ao ponto e evite preambulos ou enrolacoes.
- Ambiente: Priorize comandos, ferramentas e praticas modernas compativeis com Linux."""

# Padroes estritamente proibidos de execucao automatica (Safety Filter)
FORBIDDEN_PATTERNS = [
    r"\brm\s+-[rRfF]*\s+/(?:\s|$)",             # rm -rf /
    r"\brm\s+-[rRfF]*\s+/\*",                   # rm -rf /*
    r"\brm\s+-[rRfF]*\s+~(?:\s|/|$)",           # rm -rf ~
    r"\brm\s+-[rRfF]*\s+\$HOME(?:\s|/|$)",      # rm -rf $HOME
    r"\brm\s+-[rRfF]*\s+\*(?:\s|$)",            # rm -rf *
    r"\bmkfs(?:\.[a-z0-9]+)?\b",                # formatacao de disco
    r"\bfdisk\b",                               # particionamento
    r"\bparted\b",                              # particionamento
    r"\bwipefs\b",                              # limpeza de disco
    r"\bdd\s+if=",                              # gravacao direta dd
    r":\(\)\s*\{\s*:\s*\|\s*:\s*&\s*\}\s*;\s*:", # fork bomb
    r"\bchmod\s+-[rRfF]*\s+777\s+/",            # chmod 777 na raiz
    r"\bchown\s+-[rRfF]*\s+.*\s+/",             # chown na raiz
    r">\s*/dev/sd[a-z]",                        # sobrescrita de disco
    r">\s*/dev/nvme[0-9]",                      # sobrescrita de disco
    r"\b(shutdown|reboot|poweroff|init\s+[06])\b", # desligamento/reinicio
    r"\bkillall\s+-9\s+(systemd|init|Xorg|wayland|dbus-daemon)\b", # matar processos vitais
]

def sigint_handler(signum, frame):
    sys.stdout.write("\n[Interrompido pelo usuario]\n")
    sys.exit(0)

signal.signal(signal.SIGINT, sigint_handler)

def is_command_forbidden(cmd: str) -> tuple[bool, str]:
    cmd_clean = cmd.strip()
    for pattern in FORBIDDEN_PATTERNS:
        if re.search(pattern, cmd_clean, re.IGNORECASE):
            return True, pattern
    return False, ""

def init_prompt_file() -> Path:
    if not PROMPT_FILE.exists():
        if PROMPT_EXAMPLE.exists():
            try:
                import shutil
                shutil.copy(PROMPT_EXAMPLE, PROMPT_FILE)
            except Exception:
                pass
        if not PROMPT_FILE.exists():
            try:
                with open(PROMPT_FILE, "w", encoding="utf-8") as f:
                    f.write(DEFAULT_SYSTEM_PROMPT.strip() + "\n")
            except Exception as err:
                sys.stderr.write(f"[Erro ao criar arquivo de personalidade]: {err}\n")
    return PROMPT_FILE

def get_system_prompt() -> str:
    init_prompt_file()
    try:
        with open(PROMPT_FILE, "r", encoding="utf-8") as f:
            content = f.read().strip()
            if content:
                return content
    except Exception as err:
        sys.stderr.write(f"[Aviso ao ler personalidade]: {err}. Usando padrao interno.\n")
    return DEFAULT_SYSTEM_PROMPT.strip()

def edit_personality():
    p_file = init_prompt_file()
    editor = os.environ.get("EDITOR")
    if not editor:
        for candidate in ["micro", "nvim", "nano", "vim", "vi"]:
            if os.path.exists(f"/usr/bin/{candidate}") or os.path.exists(f"/bin/{candidate}"):
                editor = candidate
                break
    if not editor:
        editor = "vi"

    print(f"[Info]: Abrindo personalidade em {p_file} usando '{editor}'...")
    try:
        subprocess.run([editor, str(p_file)])
    except Exception as err:
        sys.stderr.write(f"[Erro ao abrir editor]: {err}\n")
        print(f"Voce pode editar diretamente o arquivo em: {p_file}")

def show_personality():
    prompt = get_system_prompt()
    print(f"=== Personalidade do Marvin ({PROMPT_FILE}) ===\n")
    print(prompt)
    print("\n" + "=" * 50)

def get_session_file(session_name: str) -> Path:
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    sanitized = "".join(c for c in session_name if c.isalnum() or c in ("-", "_")).strip()
    if not sanitized:
        sanitized = "default"
    return SESSIONS_DIR / f"{sanitized}.json"

def load_session(session_name: str):
    s_file = get_session_file(session_name)
    if s_file.exists():
        try:
            with open(s_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return []
    return []

def save_session(session_name: str, messages):
    s_file = get_session_file(session_name)
    try:
        with open(s_file, "w", encoding="utf-8") as f:
            json.dump(messages, f, ensure_ascii=False, indent=2)
    except Exception as err:
        sys.stderr.write(f"[Erro ao salvar sessao]: {err}\n")

def clear_session(session_name: str):
    s_file = get_session_file(session_name)
    if s_file.exists():
        s_file.unlink()
        print(f"[Memoria limpa]: Sessao '{session_name}' foi apagada.")
    else:
        print(f"[Info]: Nenhuma memoria encontrada para a sessao '{session_name}'.")

def show_history(session_name: str):
    messages = load_session(session_name)
    if not messages:
        print(f"[Info]: A sessao '{session_name}' esta vazia.")
        return
    print(f"=== Historico da Sessao: {session_name} ===")
    for msg in messages:
        role = msg.get("role", "desconhecido").upper()
        content = msg.get("content", "")
        print(f"\n[{role}]:\n{content}")
    print("\n" + "=" * 40)

def list_sessions():
    if not SESSIONS_DIR.exists():
        print("[Info]: Nenhuma sessao de memoria criada.")
        return
    files = list(SESSIONS_DIR.glob("*.json"))
    if not files:
        print("[Info]: Nenhuma sessao de memoria criada.")
        return
    print("=== Sessoes de Memoria ===")
    for p in files:
        name = p.stem
        try:
            with open(p, "r", encoding="utf-8") as f:
                data = json.load(f)
                count = len(data)
        except Exception:
            count = 0
        print(f"- {name} ({count} mensagens)")

def check_status():
    req = request.Request(f"http://{MARVIN_HOST}:{MARVIN_PORT}/v1/models", method="GET")
    try:
        with request.urlopen(req, timeout=3) as resp:
            if resp.status == 200:
                print(f"[Status]: Marvin online em http://{MARVIN_HOST}:{MARVIN_PORT}")
                return True
    except Exception as err:
        print(f"[Status]: Offline ou inacessivel ({err})")
        print("Sugestao: inicie com 'systemctl --user start marvin'")
        return False

def query_model_raw(prompt: str, system_prompt: str) -> str:
    payload = {
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": prompt}
        ],
        "stream": False,
        "temperature": 0.2,
    }
    data_bytes = json.dumps(payload).encode("utf-8")
    req = request.Request(
        API_URL,
        data=data_bytes,
        headers={"Content-Type": "application/json"}
    )
    try:
        with request.urlopen(req, timeout=90) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["choices"][0]["message"]["content"].strip()
    except error.URLError as e:
        sys.stderr.write(f"\n[Erro de conexao]: Nao foi possivel comunicar com o Marvin ({e.reason}).\n")
        sys.stderr.write("Verifique se o servico esta ativo executando: systemctl --user status marvin\n")
        sys.exit(1)
    except Exception as e:
        sys.stderr.write(f"\n[Erro inesperado]: {e}\n")
        sys.exit(1)

def handle_action_mode(user_instruction: str):
    action_system_prompt = (
        "Voce e o Marvin em modo de execucao operacional no Linux. "
        "Sua tarefa e gerar EXCLUSIVAMENTE o comando de terminal Bash necessario para atender ao pedido do usuario. "
        "Responda estritamente no seguinte formato estruturado:\n"
        "<<<COMMAND>>>\n"
        "<comando bash de uma ou mais linhas>\n"
        "<<<EXPLANATION>>>\n"
        "<explicacao concisa em uma frase em portugues>\n\n"
        "Regras estritas:\n"
        "- Nao use blocos markdown (```).\n"
        "- De maneira nenhuma utilize emojis.\n"
        "- Nao escreva preambulos nem texto fora das tags especificadas."
    )

    print("[Marvin]: Analisando pedido e gerando comando...")
    raw_response = query_model_raw(user_instruction, action_system_prompt)

    cmd_match = re.search(r"<<<COMMAND>>>(.*?)(?:<<<EXPLANATION.*?>|\Z)", raw_response, re.DOTALL | re.IGNORECASE)
    exp_match = re.search(r"<<<EXPLANATION.*?>\s*(.*?)(?:<<<|\Z)", raw_response, re.DOTALL | re.IGNORECASE)

    if cmd_match and cmd_match.group(1).strip():
        command = cmd_match.group(1).strip()
        explanation = exp_match.group(1).strip() if exp_match and exp_match.group(1).strip() else "Executar operacao solicitada"
    else:
        # Fallback limpo caso o modelo omita as tags
        cleaned = raw_response.replace("```bash", "").replace("```sh", "").replace("```", "").strip()
        command = cleaned
        explanation = "Executar comando correspondente"

    # Limpeza de formatacao residual
    command = re.sub(r"<<<.*?>>>", "", command).strip("` \n\r")
    explanation = re.sub(r"<<<.*?>>>", "", explanation).strip("` \n\r")

    print("\n" + "=" * 55)
    print(f"[Marvin propos a seguinte acao]:")
    print(f"  Finalidade: {explanation}")
    print(f"  Comando:    {command}")
    print("=" * 55)

    try:
        confirm = input("\nDeseja executar este comando? [s/N]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print("\n[Acao cancelada]")
        return

    if confirm not in ("s", "sim", "y", "yes"):
        print("[Acao cancelada pelo usuario]")
        return

    # Validacao de Seguranca (Safety Filter)
    is_blocked, pattern = is_command_forbidden(command)
    if is_blocked:
        print("\n" + "!" * 55)
        print("[Bloqueio de Seguranca]:")
        print(f"Tentei executar o comando: {command}")
        print("Esse comando esbarrou em uma protecao de seguranca interna do Marvin (padrao restrito detectado).")
        print("Como o Marvin nao tem permissao para rodar essa operacao automaticamente, se voce realmente desejar executa-la, execute manualmente no seu terminal:")
        print(f"\n  {command}\n")
        print("!" * 55)
        return

    # Execucao do comando seguro
    print(f"\n[Executando]: {command}")
    print("-" * 55)
    try:
        ret = subprocess.run(command, shell=True)
        print("-" * 55)
        if ret.returncode == 0:
            print("[Comando concluido com sucesso]")
        else:
            print(f"[Comando finalizado com codigo de retorno {ret.returncode}]")
    except Exception as err:
        print(f"[Erro na execucao]: {err}")

def stream_chat(messages, system_prompt: str = None) -> str:
    full_messages = []
    if system_prompt:
        full_messages.append({"role": "system", "content": system_prompt})
    full_messages.extend(messages)

    payload = {
        "messages": full_messages,
        "stream": True,
        "temperature": 0.6,
    }

    data_bytes = json.dumps(payload).encode("utf-8")
    req = request.Request(
        API_URL,
        data=data_bytes,
        headers={"Content-Type": "application/json"}
    )

    complete_reply = []

    try:
        with request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line:
                    continue
                if line.startswith("data: "):
                    chunk_str = line[6:].strip()
                    if chunk_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(chunk_str)
                        delta = chunk.get("choices", [{}])[0].get("delta", {})
                        token = delta.get("content", "")
                        if token:
                            sys.stdout.write(token)
                            sys.stdout.flush()
                            complete_reply.append(token)
                    except json.JSONDecodeError:
                        continue
            sys.stdout.write("\n")
            sys.stdout.flush()
    except error.URLError as e:
        sys.stderr.write(f"\n[Erro de conexao]: Nao foi possivel comunicar com o Marvin ({e.reason}).\n")
        sys.stderr.write("Verifique se o servico esta ativo executando: systemctl --user status marvin\n")
        sys.exit(1)
    except Exception as e:
        sys.stderr.write(f"\n[Erro inesperado]: {e}\n")
        sys.exit(1)

    return "".join(complete_reply)

def interactive_repl(session_name: str, use_memory: bool, system_prompt: str):
    print(f"Marvin Chat Interativo (Modo: {'Memoria: ' + session_name if use_memory else 'Stateless'})")
    print("Digite 'sair', 'exit' ou Ctrl+C para encerrar.")
    print("Dica: digite '/x <pedido>' para executar uma acao operacional.\n")

    history = load_session(session_name) if use_memory else []

    while True:
        try:
            prompt = input("voce> ").strip()
        except EOFError:
            break

        if not prompt:
            continue
        if prompt.lower() in ("sair", "exit", "quit"):
            break
        if prompt == "/clear":
            if use_memory:
                clear_session(session_name)
                history = []
            else:
                print("[Info]: Modo stateless nao possui historico gravado.")
            continue
        if prompt.startswith("/x ") or prompt.startswith("/exec "):
            action_query = prompt.split(" ", 1)[1].strip()
            handle_action_mode(action_query)
            print()
            continue

        print("marvin> ", end="", flush=True)
        current_conversation = history + [{"role": "user", "content": prompt}]
        answer = stream_chat(current_conversation, system_prompt)

        if use_memory:
            history.append({"role": "user", "content": prompt})
            history.append({"role": "assistant", "content": answer})
            save_session(session_name, history)
        print()

def main():
    parser = argparse.ArgumentParser(
        prog="mvn",
        description="Cliente de terminal para o assistente local Marvin.",
        add_help=False
    )
    parser.add_argument("-h", "--help", action="store_true", help="Mostra esta ajuda.")
    parser.add_argument("-m", "--memory", action="store_true", help="Usa a memoria/sessao padrao.")
    parser.add_argument("-s", "--session", type=str, default=None, help="Nome da sessao de memoria a ser usada.")
    parser.add_argument("-x", "--exec", dest="execute_action", action="store_true", help="Modo operacional: gera e executa comando apos confirmacao.")
    parser.add_argument("-c", "--clear", nargs="?", const="", default=None, help="Limpa o historico da memoria.")
    parser.add_argument("-l", "--history", nargs="?", const="", default=None, help="Exibe o historico da memoria.")
    parser.add_argument("--sessions", action="store_true", help="Lista todas as sessoes salvas.")
    parser.add_argument("--status", action="store_true", help="Verifica se o servico Marvin esta respondendo.")
    parser.add_argument("--prompt", "--personality", dest="edit_prompt", action="store_true", help="Abre o arquivo de personalidade no editor.")
    parser.add_argument("--show-prompt", action="store_true", help="Exibe a personalidade ativa do Marvin.")
    parser.add_argument("--system", type=str, default=None, help="Sobrescreve o prompt de sistema para esta chamada.")
    parser.add_argument("query", nargs="*", help="Pergunta ou comando para o Marvin.")

    args = parser.parse_args()

    if args.help:
        parser.print_help()
        print("\nExemplos de uso:")
        print("  mvn o que e RAG?                  (Pergunta direta sem memoria)")
        print("  mvn -m continue a explicacao      (Pergunta usando memoria padrao)")
        print("  mvn -s projeto 'como fazer X?'    (Pergunta usando a sessao 'projeto')")
        print("  mvn -x verifique o uso de memoria (Gera e executa comando com confirmacao)")
        print("  mvn -c                            (Limpa memoria padrao)")
        print("  mvn -c projeto                    (Limpa memoria da sessao 'projeto')")
        print("  mvn -l                            (Exibe historico da sessao padrao)")
        print("  mvn --show-prompt                 (Exibe as instrucoes/personalidade ativa)")
        print("  mvn --prompt                      (Abre o arquivo de personalidade no editor)")
        print("  cat script.py | mvn 'explique'    (Le entrada via pipe)")
        print("  mvn                               (Inicia chat interativo)")
        return

    if args.status:
        check_status()
        return

    if args.edit_prompt:
        edit_personality()
        return

    if args.show_prompt:
        show_personality()
        return

    if args.sessions:
        list_sessions()
        return

    # Limpar sessao
    if args.clear is not None:
        target = args.clear.strip() or args.session or "default"
        clear_session(target)
        return

    # Exibir historico
    if args.history is not None:
        target = args.history.strip() or args.session or "default"
        show_history(target)
        return

    # Resolver system prompt
    active_system_prompt = args.system if args.system is not None else get_system_prompt()

    # Juntar os argumentos da pergunta
    user_query = " ".join(args.query).strip()

    # Verificar se ha entrada via pipe (apenas se nao for modo acao com pergunta ja informada)
    pipe_input = ""
    if not (args.execute_action and user_query) and not sys.stdin.isatty():
        try:
            pipe_input = sys.stdin.read().strip()
        except Exception:
            pipe_input = ""

    if pipe_input:
        if user_query:
            user_query = f"{user_query}\n\nContexto / Entrada adicional:\n{pipe_input}"
        else:
            user_query = pipe_input

    # Modo Acao / Execucao Operacional (-x)
    if args.execute_action:
        if not user_query:
            sys.stderr.write("[Erro]: Especifique a acao desejada. Exemplo: mvn -x verifique o uso de memoria\n")
            sys.exit(1)
        handle_action_mode(user_query)
        return

    # Se nao ha pergunta e stdin e um terminal, inicia REPL interativo
    if not user_query:
        if sys.stdin.isatty():
            use_memory = bool(args.session or args.memory)
            session_name = args.session or "default"
            interactive_repl(session_name, use_memory, active_system_prompt)
            return
        else:
            sys.stderr.write("[Erro]: Nenhuma pergunta fornecida via argumento ou pipe.\n")
            sys.exit(1)

    # Determinar se usa memoria e qual sessao
    use_memory = False
    session_name = "default"

    if args.session:
        use_memory = True
        session_name = args.session
    elif args.memory:
        use_memory = True
        session_name = "default"

    # Modo pergunta direta (stateless ou com memoria)
    if use_memory:
        history = load_session(session_name)
        conversation = history + [{"role": "user", "content": user_query}]
        answer = stream_chat(conversation, active_system_prompt)
        history.append({"role": "user", "content": user_query})
        history.append({"role": "assistant", "content": answer})
        save_session(session_name, history)
    else:
        conversation = [{"role": "user", "content": user_query}]
        stream_chat(conversation, active_system_prompt)

if __name__ == "__main__":
    main()
