# Padroes estritamente proibidos de execucao automatica (Safety Filter)
FORBIDDEN_PATTERNS = [
    r"\brm\s+-[rRfF]*\s+/(?:\s|$)",             # rm -rf /
    r"\brm\s+-[rRfF]*\s+/\*",                   # rm -rf /*
    r"\brm\s+-[rRfF]*\s+~(?:\s|/|$)",           # rm -rf ~
    r"\brm\s+-[rRfF]*\s+\$HOME(?:\s|/|$)",      # rm -rf $HOME
    r"\brm\s+-[rRfF]*\s+\*(?:\s|$)",            # rm -rf *
    r"\bmkfs(?:\.[a-z0-9]+)?\b",                # formatacao de disco
    r"\bfdisk\b",                               # particionamento
    r"\bparted\b",                              # particionamento
    r"\bwipefs\b",                              # limpeza de disco
    r"\bdd\s+if=",                              # gravacao direta dd
    r":\(\)\s*\{\s*:\s*\|\s*:\s*&\s*\}\s*;\s*:", # fork bomb
    r"\bchmod\s+-[rRfF]*\s+777\s+/",            # chmod 777 na raiz
    r"\bchown\s+-[rRfF]*\s+.*\s+/",             # chown na raiz
    r">\s*/dev/sd[a-z]",                        # sobrescrita de disco
    r">\s*/dev/nvme[0-9]",                      # sobrescrita de disco
    r"\b(shutdown|reboot|poweroff|init\s+[06])\b", # desligamento/reinicio
    r"\bkillall\s+-9\s+(systemd|init|Xorg|wayland|dbus-daemon)\b", # matar processos vitais
]

def sigint_handler(signum, frame):
    sys.stdout.write("\n[Interrompido pelo usuario]\n")
    sys.exit(0)

signal.signal(signal.SIGINT, sigint_handler)

def is_command_forbidden(cmd: str) -> tuple[bool, str]:
    cmd_clean = cmd.strip()
    for pattern in FORBIDDEN_PATTERNS:
        if re.search(pattern, cmd_clean, re.IGNORECASE):
            return True, pattern
    return False, ""

def init_prompt_file() -> Path:
    if not PROMPT_FILE.exists():
        if PROMPT_EXAMPLE.exists():
            try:
                import shutil
                shutil.copy(PROMPT_EXAMPLE, PROMPT_FILE)
            except Exception:
                pass
        if not PROMPT_FILE.exists():
            try:
                with open(PROMPT_FILE, "w", encoding="utf-8") as f:
                    f.write(DEFAULT_SYSTEM_PROMPT.strip() + "\n")
            except Exception as err:
                sys.stderr.write(f"[Erro ao criar arquivo de personalidade]: {err}\n")
    return PROMPT_FILE

def get_system_prompt() -> str:
    init_prompt_file()
    try:
        with open(PROMPT_FILE, "r", encoding="utf-8") as f:
            content = f.read().strip()
            if content:
                return content
    except Exception as err:
        sys.stderr.write(f"[Aviso ao ler personalidade]: {err}. Usando padrao interno.\n")
    return DEFAULT_SYSTEM_PROMPT.strip()

