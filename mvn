            messages.append({
                "role": "user",
                "content": "Voce ainda nao executou nenhum comando no sistema. Proponha um comando Bash usando <<<ACTION>>> para inspecionar os dados reais antes de concluir."
            })
            raw_response = query_messages_raw(messages)

        # Se o modelo concluiu a tarefa e gerou a resposta final
        if turn > 1 and "<<<FINAL_ANSWER>>>" in raw_response:
            final_text = raw_response.split("<<<FINAL_ANSWER>>>", 1)[1].strip()
            print("\n" + "=" * 55)
            print("[Marvin - Relatorio Final]:")
            print(final_text)
            print("=" * 55)
            return

        # Extrair comando e explicacao
        command = ""
        explanation = ""
        if "<<<ACTION>>>" in raw_response:
            action_block = raw_response.split("<<<ACTION>>>", 1)[1].strip()
            cmd_match = re.search(r"Comando:\s*(.*?)(?:\nFinalidade:|\n\n|\Z)", action_block, re.DOTALL | re.IGNORECASE)
            exp_match = re.search(r"Finalidade:\s*(.*?)(?:\nComando:|\n\n|\Z)", action_block, re.DOTALL | re.IGNORECASE)
            if cmd_match:
                command = cmd_match.group(1).strip()
            if exp_match:
                explanation = exp_match.group(1).strip()
        else:
            # Fallback tolerante para outras tags
            cmd_match = re.search(r"<<<COMMAND>>>(.*?)(?:<<<EXPLANATION.*?>|\Z)", raw_response, re.DOTALL | re.IGNORECASE)
            exp_match = re.search(r"<<<EXPLANATION.*?>\s*(.*?)(?:<<<|\Z)", raw_response, re.DOTALL | re.IGNORECASE)
            if cmd_match and cmd_match.group(1).strip():
                command = cmd_match.group(1).strip()
                explanation = exp_match.group(1).strip() if exp_match else "Executar operacao"
            else:
                cleaned = raw_response.replace("```bash", "").replace("```sh", "").replace("```", "").strip()
                if cleaned.startswith(("ls", "df", "du", "cat", "uname", "ps", "find", "grep")):
                    command = cleaned
                    explanation = "Executar comando correspondente"
                else:
                    print("\n" + "=" * 55)
                    print("[Marvin - Relatorio Final]:")
                    print(cleaned)
                    print("=" * 55)
                    return

        command = re.sub(r"<<<.*?>>>", "", command).strip("` \n\r")
        explanation = re.sub(r"<<<.*?>>>", "", explanation).strip("` \n\r")
        if not explanation:
            explanation = "Executar consulta no sistema"

        print("\n" + "=" * 55)
        print(f"[Passo {turn}/{MAX_ACTION_TURNS}] Marvin propos:")
        print(f"  Finalidade: {explanation}")
        print(f"  Comando:    {command}")
        print("=" * 55)

        try:
            confirm = input("\nDeseja executar este comando? [s/N]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\n[Operacao cancelada]")
            return

        if confirm not in ("s", "sim", "y", "yes"):
            print("[Operacao interrompida pelo usuario]")
            return

        # Validacao de Seguranca (Safety Filter)
        is_blocked, pattern = is_command_forbidden(command)
        if is_blocked:
            print("\n" + "!" * 55)
            print("[Bloqueio de Seguranca]:")
            print(f"Tentei executar o comando: {command}")
            print("Esse comando esbarrou em uma protecao de seguranca interna do Marvin (padrao restrito detectado).")
            print("Como o Marvin nao tem permissao para rodar essa operacao automaticamente, se voce realmente desejar executa-la, execute manualmente no seu terminal:")
            print(f"\n  {command}\n")
            print("!" * 55)
            return

        # Execucao do comando com captura completa de saida
        print(f"\n[Executando]: {command}")
        print("-" * 55)
        try:
            res = subprocess.run(command, shell=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            stdout = res.stdout
            stderr = res.stderr
            returncode = res.returncode
        except Exception as err:
            stdout = ""
            stderr = str(err)
            returncode = -1

        if stdout:
            sys.stdout.write(stdout)
            if not stdout.endswith("\n"):
                sys.stdout.write("\n")
        if stderr:
            sys.stderr.write(f"[stderr]: {stderr}")
            if not stderr.endswith("\n"):
                sys.stderr.write("\n")
        print("-" * 55)

        # Truncar saidas muito extensas para poupar a janela de contexto
        combined = (stdout + ("\n" + stderr if stderr else "")).strip()
        lines = combined.splitlines()
        if len(lines) > 40:
            sample = "\n".join(lines[:35]) + f"\n... [truncado: {len(lines) - 35} linhas omitidas]"
        else:
            sample = combined[:2500]

        # Alimentar historico da investigacao
        messages.append({"role": "assistant", "content": f"<<<ACTION>>>\nComando: {command}\nFinalidade: {explanation}"})

        if turn == MAX_ACTION_TURNS:
            prompt_next = (
                f"Resultado do comando '{command}' (Codigo de retorno: {returncode}):\n{sample}\n\n"
                "Voce atingiu o limite maximo de passos operacionais. "
                "Responda OBRIGATORIAMENTE com <<<FINAL_ANSWER>>> sintetizando e explicando os resultados obtidos para o usuario."
            )
        else:
            prompt_next = (
                f"Resultado do comando '{command}' (Codigo de retorno: {returncode}):\n{sample}\n\n"
                "Analise o resultado obtido:\n"
                "- Se as informacoes ja forem suficientes para atender ao pedido do usuario, responda com <<<FINAL_ANSWER>>> explicando o que descobriu em detalhes.\n"
                "- Se o comando falhou ou se voce precisa de mais informacoes para responder com precisao, responda com <<<ACTION>>> propondo o proximo comando."
            )
        messages.append({"role": "user", "content": prompt_next})
        print("[Marvin]: Analisando o resultado...")

    # Se atingiu o fim dos turnos sem fechar com tag, forcar relatorio final
    final_raw = query_messages_raw(messages)
    final_clean = final_raw.replace("<<<FINAL_ANSWER>>>", "").strip()
    print("\n" + "=" * 55)
    print("[Marvin - Relatorio Final]:")
    print(final_clean)
    print("=" * 55)

def stream_chat(messages, system_prompt: str = None, allow_web_search: bool = True, search_options: dict = None) -> str:
    if allow_web_search:
        latest_user_message = next(
            (msg.get("content", "") for msg in reversed(messages) if msg.get("role") == "user"),
            "",
        )
        if FRESHNESS_QUERY.search(latest_user_message):
            search_query = latest_user_message.split("\n\nContexto / Entrada adicional:", 1)[0].strip()[:500]
            return answer_with_web_search(messages, system_prompt, search_query, search_options)

    system_instructions = []
    if system_prompt:
        system_instructions.append(system_prompt)
    if allow_web_search:
        system_instructions.append(WEB_SEARCH_SYSTEM_PROMPT)
    full_messages = []
    if system_instructions:
        full_messages.append({"role": "system", "content": "\n\n".join(system_instructions)})
    full_messages.extend(messages)

    payload = {
        "messages": full_messages,
        "stream": True,
        "temperature": 0.6,
    }

    data_bytes = json.dumps(payload).encode("utf-8")
    req = request.Request(
        API_URL,
        data=data_bytes,
        headers={"Content-Type": "application/json"}
    )

    complete_reply = []
    undecided = ""
    search_request = None
    searching = False

    def emit(text: str):
        if text:
            sys.stdout.write(text)
            sys.stdout.flush()
            complete_reply.append(text)

    try:
        with request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line:
                    continue
                if line.startswith("data: "):
                    chunk_str = line[6:].strip()
                    if chunk_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(chunk_str)
                        delta = chunk.get("choices", [{}])[0].get("delta", {})
                        token = delta.get("content", "")
                        if token:
                            if searching:
                                search_request = (search_request or "") + token
                            elif allow_web_search:
                                undecided += token
                                candidate = undecided.lstrip()
                                if not candidate or WEB_SEARCH_MARKER.startswith(candidate):
                                    continue
                                if candidate.startswith(WEB_SEARCH_MARKER):
                                    searching = True
                                    search_request = candidate[len(WEB_SEARCH_MARKER):]
                                else:
                                    emit(undecided)
                                    undecided = ""
                                    allow_web_search = False
                            else:
                                emit(token)
                    except json.JSONDecodeError:
                        continue

            if not searching and undecided:
                emit(undecided)
            if searching:
                try:
                    request_data = json.loads((search_request or "").strip())
                    search_query = str(request_data.get("query", "")).strip()
                except (json.JSONDecodeError, AttributeError, RuntimeError) as err:
                    answer = "\n[Pesquisa na web indisponível]: solicitação inválida do modelo."
                    print(answer + "\n")
                    complete_reply = [answer]
                    return "".join(complete_reply)
                answer = answer_with_web_search(
                    messages,
                    system_prompt,
                    search_query,
                    {
                        **{key: request_data.get(key) for key in ("categories", "time_range", "engines", "language")},
                        **{key: value for key, value in (search_options or {}).items() if value is not None},
                    },
                )
                complete_reply = [answer]
            else:
                sys.stdout.write("\n")
                sys.stdout.flush()
    except error.HTTPError as e:
        report_api_http_error(e)
        sys.exit(1)
    except error.URLError as e:
        sys.stderr.write(f"\n[Erro de conexao]: Nao foi possivel comunicar com o Marvin ({e.reason}).\n")
        sys.stderr.write("Verifique se o servico esta ativo executando: systemctl --user status marvin\n")
        sys.exit(1)
    except Exception as e:
        sys.stderr.write(f"\n[Erro inesperado]: {e}\n")
        sys.exit(1)

    return "".join(complete_reply)

def interactive_repl(session_name: str, use_memory: bool, system_prompt: str):
    print(f"Marvin Chat Interativo (Modo: {'Memoria: ' + session_name if use_memory else 'Stateless'})")
    print("Digite 'sair', 'exit' ou Ctrl+C para encerrar.")
    print("Dica: digite '/x <pedido>' para executar uma acao operacional.\n")

    history = trim_history(load_session(session_name)) if use_memory else []

    while True:
        try:
            prompt = input("voce> ").strip()
        except EOFError:
            break

        if not prompt:
            continue
        if prompt.lower() in ("sair", "exit", "quit"):
            break
        if prompt == "/clear":
            if use_memory:
                clear_session(session_name)
                history = []
            else:
                print("[Info]: Modo stateless nao possui historico gravado.")
            continue
        force_web_search = prompt.startswith("/web ")
        disable_web_search = prompt.startswith("/no-web ")
        if force_web_search or disable_web_search:
            prompt = prompt.split(" ", 1)[1].strip()
            if not prompt:
                print("[Info]: Informe a pergunta depois de /web ou /no-web.")
                continue
        if prompt.startswith("/x ") or prompt.startswith("/exec "):
            action_query = prompt.split(" ", 1)[1].strip()
            handle_action_mode(action_query)
            print()
            continue

        print("marvin> ", end="", flush=True)
        current_conversation = history + [{"role": "user", "content": prompt}]
        if force_web_search:
            answer = answer_with_web_search(current_conversation, system_prompt, prompt)
        else:
            answer = stream_chat(current_conversation, system_prompt, allow_web_search=not disable_web_search)

        if use_memory:
            history.append({"role": "user", "content": prompt})
            history.append({"role": "assistant", "content": answer})
            history = trim_history(history)
            save_session(session_name, history)
        print()

def main():
    parser = argparse.ArgumentParser(
        prog="mvn",
        description="Cliente de terminal para o assistente local Marvin.",
        add_help=False
    )
    parser.add_argument("-h", "--help", action="store_true", help="Mostra esta ajuda.")
    parser.add_argument("-m", "--memory", action="store_true", help="Usa a memoria/sessao padrao.")
    parser.add_argument("-s", "--session", type=str, default=None, help="Nome da sessao de memoria a ser usada.")
    parser.add_argument("-x", "--exec", dest="execute_action", action="store_true", help="Modo operacional: gera e executa comando apos confirmacao.")
    parser.add_argument("-c", "--clear", nargs="?", const="", default=None, help="Limpa o historico da memoria.")
    parser.add_argument("-l", "--history", nargs="?", const="", default=None, help="Exibe o historico da memoria.")
    parser.add_argument("--sessions", action="store_true", help="Lista todas as sessoes salvas.")
    parser.add_argument("--status", action="store_true", help="Verifica se o servico Marvin esta respondendo.")
    parser.add_argument("--prompt", "--personality", dest="edit_prompt", action="store_true", help="Abre o arquivo de personalidade no editor.")
    parser.add_argument("--show-prompt", action="store_true", help="Exibe a personalidade ativa do Marvin.")
    parser.add_argument("--system", type=str, default=None, help="Sobrescreve o prompt de sistema para esta chamada.")
    web_group = parser.add_mutually_exclusive_group()
    web_group.add_argument("--web-search", action="store_true", help="Força uma pesquisa web para esta pergunta.")
    web_group.add_argument("--no-web-search", action="store_true", help="Desativa a pesquisa web para esta pergunta.")
    parser.add_argument("--search-engines", type=str, default=None, help="Mecanismos SearXNG separados por vírgula, por exemplo google,bing.")
    parser.add_argument("--search-category", choices=["general", "it", "news", "science", "files", "images", "videos", "music", "map"], default=None, help="Categoria de pesquisa do SearXNG.")
    parser.add_argument("--search-time-range", choices=["day", "week", "month", "year"], default=None, help="Recorte temporal da pesquisa.")
    parser.add_argument("query", nargs="*", help="Pergunta ou comando para o Marvin.")

    args = parser.parse_args()

    if args.help:
        parser.print_help()
        print("\nExemplos de uso:")
        print("  mvn o que e RAG?                  (Pergunta direta sem memoria)")
        print("  mvn -m continue a explicacao      (Pergunta usando memoria padrao)")
        print("  mvn -s projeto 'como fazer X?'    (Pergunta usando a sessao 'projeto')")
        print("  mvn -x verifique o uso de memoria (Gera e executa comando com confirmacao)")
        print("  mvn -c                            (Limpa memoria padrao)")
        print("  mvn -c projeto                    (Limpa memoria da sessao 'projeto')")
        print("  mvn -l                            (Exibe historico da sessao padrao)")
        print("  mvn --show-prompt                 (Exibe as instrucoes/personalidade ativa)")
        print("  mvn --prompt                      (Abre o arquivo de personalidade no editor)")
        print("  cat script.py | mvn 'explique'    (Le entrada via pipe)")
        print("  mvn                               (Inicia chat interativo)")
        return

    if args.status:
        check_status()
        return

    if args.edit_prompt:
        edit_personality()
        return

    if args.show_prompt:
        show_personality()
        return

    if args.sessions:
        list_sessions()
        return

    # Limpar sessao
    if args.clear is not None:
        target = args.clear.strip() or args.session or "default"
        clear_session(target)
        return

    # Exibir historico
    if args.history is not None:
        target = args.history.strip() or args.session or "default"
        show_history(target)
        return

    # Resolver system prompt
    active_system_prompt = args.system if args.system is not None else get_system_prompt()

    # Juntar os argumentos da pergunta
    user_query = " ".join(args.query).strip()

    # Verificar se ha entrada via pipe (apenas se nao for modo acao com pergunta ja informada)
    pipe_input = ""
    if not (args.execute_action and user_query) and not sys.stdin.isatty():
        try:
            pipe_input = sys.stdin.read().strip()
        except Exception:
            pipe_input = ""

    if pipe_input:
        if user_query:
            user_query = f"{user_query}\n\nContexto / Entrada adicional:\n{pipe_input}"
        else:
            user_query = pipe_input

    # Modo Acao / Execucao Operacional (-x)
    if args.execute_action:
        if not user_query:
            sys.stderr.write("[Erro]: Especifique a acao desejada. Exemplo: mvn -x verifique o uso de memoria\n")
            sys.exit(1)
        handle_action_mode(user_query)
        return

    # Se nao ha pergunta e stdin e um terminal, inicia REPL interativo
    if not user_query:
        if sys.stdin.isatty():
            use_memory = bool(args.session or args.memory)
            session_name = args.session or "default"
            interactive_repl(session_name, use_memory, active_system_prompt)
            return
        else:
            sys.stderr.write("[Erro]: Nenhuma pergunta fornecida via argumento ou pipe.\n")
            sys.exit(1)

    # Determinar se usa memoria e qual sessao
    use_memory = False
    session_name = "default"

    if args.session:
        use_memory = True
        session_name = args.session
    elif args.memory:
        use_memory = True
        session_name = "default"

    # Modo pergunta direta (stateless ou com memoria)
    if use_memory:
        history = trim_history(load_session(session_name))
        conversation = history + [{"role": "user", "content": user_query}]
        search_options = {"engines": args.search_engines, "categories": args.search_category, "time_range": args.search_time_range}
        if args.web_search:
            answer = answer_with_web_search(conversation, active_system_prompt, user_query, search_options)
        else:
            answer = stream_chat(conversation, active_system_prompt, allow_web_search=not args.no_web_search, search_options=search_options)
        history.append({"role": "user", "content": user_query})
        history.append({"role": "assistant", "content": answer})
        history = trim_history(history)
        save_session(session_name, history)
    else:
        conversation = [{"role": "user", "content": user_query}]
        search_options = {"engines": args.search_engines, "categories": args.search_category, "time_range": args.search_time_range}
        if args.web_search:
            answer_with_web_search(conversation, active_system_prompt, user_query, search_options)
        else:
            stream_chat(conversation, active_system_prompt, allow_web_search=not args.no_web_search, search_options=search_options)

if __name__ == "__main__":
    main()
